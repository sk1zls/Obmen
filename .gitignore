# Обмен — что не попадает в репозиторий.
# Всё перечисленное создаётся сборкой, тестами или самой программой и содержит
# машинно-зависимые данные: пути, порты, имя узла.

# ---- сборка: build.bat и CMake пишут в build/ ----
/build/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.obj
*.res
*.pdb
*.ilk
*.exp
*.exe

# ---- настройки узла (внутри абсолютные пути и имя этого компьютера) ----
obmen.ini

# ---- артефакты тестовых сценариев: их создают сами test\*.ps1 ----
/test/*.ini
/test/*.log
/test/dl.txt
/test/dom-*.html
/test/edge-*/
/test/*share*/

# ---- состояние синхронизации и недописанные передачи ----
.obmen-state.json
*.part

# ---- редакторы и IDE ----
.vs/
.vscode/
.idea/
*.user
*.suo

# ---- система ----
Thumbs.db
desktop.ini
.DS_Store
